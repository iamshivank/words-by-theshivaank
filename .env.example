# Copy to .env and fill in. Never commit .env.

# Paste Neon's connection string as-is (postgresql://user:pass@host/db?sslmode=require);
# the backend converts it to JDBC and takes the user and password from it.
# The JDBC form (jdbc:postgresql://host/db?sslmode=require + the two variables below) also works.
# Use the DIRECT (non-pooler) host, i.e. without "-pooler" in the hostname, so Flyway migrations work.
SPRING_DATASOURCE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Single owner account. These seed the account on first start; after that you can change the email and
# password in the admin panel (/desk/admin/account), and the database copy wins.
OWNER_EMAIL=
# bcrypt hash of your password. Generate with:  cd backend && ./mvnw -q compile exec:java
# Paste the hash as-is (no quotes needed, $ signs are kept literally).
OWNER_PASSWORD_HASH=
# At least 32 random characters. Generate with:  openssl rand -base64 48
JWT_SECRET=

APP_PUBLIC_URL=http://localhost:5173
UPLOAD_DIR=./uploads

# Optional. Forgot the password you set in the admin panel? Set this to true for ONE restart to reset the
# account to OWNER_EMAIL / OWNER_PASSWORD_HASH above (this also signs out every device), then remove it.
# OWNER_RESET_FROM_ENV=false

# Optional. Set to false only for local http development if your browser refuses Secure cookies on localhost.
# COOKIE_SECURE=true
